        },
        "ckb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "مایکرۆفۆن بوەستێنە"
          }
        },
        "kmr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mîkrofonê rawestîne"
          }
        }
      }
    },
    "Stop receiver": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop receiver"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "وەرگر بوەستێنە"
          }
        },
        "kmr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wergirê rawestîne"
          }
        }
      }
    },
    "Streaming to receiver at": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Streaming to receiver at"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "دەنگ دەنێرێت بۆ وەرگر لە"
          }
        },
        "kmr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deng ji bo wergirê li vir tê şandin:"
          }
        }
      }
    },
    "Streams 48 kHz mono PCM audio to a PocketMic receiver on the same private Wi-Fi network. Enter the receiver IP address and pairing key shown in its app.": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Streams 48 kHz mono PCM audio to a PocketMic receiver on the same private Wi-Fi network. Enter the receiver IP address and pairing key shown in its app."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "دەنگی PCM مۆنۆی 48 kHz بۆ وەرگری PocketMic لەسەر هەمان تۆڕی تایبەتی Wi-Fi دەنێرێت. ناونیشانی IP و کلیلی هاوتاکردنی نیشاندراو لە ئەپی وەرگر بنووسە."
          }
        },
        "kmr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dengê PCM mono ya 48 kHz ji bo wergirekî PocketMic li ser heman tora taybet a Wi-Fi dişîne. Navnîşana IP û mifteya cotkirinê ya di sepana wergir de xuya dibe binivîse."
          }
        }
      }
    },
    "This audio session reached the packet limit. Start a new session to keep encryption nonces unique.": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "This audio session reached the packet limit. Start a new session to keep encryption nonces unique."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ئەم دانیشتنە گەیشتە سنووری پاکێتەکان. دانیشتنێکی نوێ دەستپێبکە بۆ پاراستنی تایبەتی nonceی نهێنیکردن."
          }
        },
        "kmr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ev danîştina dengê gihîşt sînorê pakêtan. Ji bo ku nonceyên şîfrekirinê yekta bimînin, danîştineke nû bide destpêkirin."
          }
        }
      }
    },
    "Use the same pairing key in the Android or iOS sender. Enter this Mac’s local network address in the sender.": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the same pairing key in the Android or iOS sender. Enter this Mac’s local network address in the sender."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "هەمان کلیلی هاوتاکردن لە نێرەری Android یان iOS بەکاربهێنە. ناونیشانی تۆڕی ناوخۆیی ئەم Macە لە نێرەر بنووسە."
          }
        },
        "kmr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Di şandera Android an iOS de heman mifteya cotkirinê bi kar bîne. Navnîşana tora herêmî ya vê Macê di şanderê de binivîse."
          }
        }
      }
