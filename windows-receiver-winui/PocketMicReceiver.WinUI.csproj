<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <UseWinUI>true</UseWinUI>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WinForms supplies NotifyIcon only; retain WinUI's XAML compiler, not WPF's targets. -->
    <ImportFrameworkWinFXTargets>true</ImportFrameworkWinFXTargets>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <AssemblyName>PocketMicReceiver.WinUI</AssemblyName>
    <RootNamespace>PocketMicReceiver.WinUI</RootNamespace>
    <Version>0.1.7</Version>
    <ApplicationIcon>..\windows-receiver\Assets\PocketMic.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" GeneratePathProperty="true" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.1839" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <ProjectReference Include="..\windows-receiver-core\PocketMicReceiver.Core.csproj" />
    <Content Include="..\windows-receiver\Assets\PocketMic.ico" Link="PocketMic.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(PkgMicrosoft_WindowsAppSDK)\license.txt" Link="WINDOWS-APP-SDK-LICENSE.txt"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(PkgMicrosoft_WindowsAppSDK)\NOTICE.txt" Link="WINDOWS-APP-SDK-NOTICE.txt"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Unpackaged WinUI generates these in TargetDir, but the .NET publish inventory omits them. -->
  <Target Name="PublishWinUIResources" AfterTargets="ComputeFilesToPublish">
    <Error Condition="!Exists('$(TargetDir)App.xbf')" Text="WinUI App.xbf was not generated; refusing an unusable publish." />
    <Error Condition="!Exists('$(TargetDir)$(AssemblyName).pri')" Text="WinUI application PRI was not generated; refusing an unusable publish." />
    <ItemGroup>
      <ResolvedFileToPublish Remove="$(TargetDir)App.xbf;$(TargetDir)$(AssemblyName).pri" />
      <ResolvedFileToPublish Include="$(TargetDir)App.xbf" RelativePath="App.xbf" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
      <ResolvedFileToPublish Include="$(TargetDir)$(AssemblyName).pri" RelativePath="$(AssemblyName).pri" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    </ItemGroup>
  </Target>
</Project>
